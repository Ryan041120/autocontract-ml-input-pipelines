{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/autocontract/final-public-v1.schema.json",
  "title": "AutoContract final blind benchmark public manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "benchmark_id",
    "status",
    "created_at",
    "selection_author",
    "claim_scope",
    "analyzer_bundle",
    "contamination_policy",
    "metric_gates",
    "units"
  ],
  "properties": {
    "schema_version": {"const": "autocontract.final-public.v1"},
    "artifact_type": {"const": "public_manifest"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$"},
    "status": {"enum": ["draft", "sealed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "selection_author": {"type": "string", "minLength": 1},
    "claim_scope": {"type": "string", "minLength": 20},
    "analyzer_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_system", "optimizer_policy", "runner_path", "adapter_paths"],
      "properties": {
        "effect_system": {"type": "string", "minLength": 1},
        "optimizer_policy": {"type": "string", "minLength": 1},
        "runner_path": {"type": "string", "minLength": 1},
        "adapter_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "contamination_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "selection_cutoff", "minimum_novel_frameworks"],
      "properties": {
        "registry_path": {"type": "string", "minLength": 1},
        "selection_cutoff": {"type": "string", "format": "date-time"},
        "minimum_novel_frameworks": {"type": "integer", "minimum": 1}
      }
    },
    "metric_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_unsafe_false_accepts_max",
        "safe_recall_min",
        "coarse_reason_accuracy_min",
        "analyzer_coverage_min",
        "oracle_benefit_coverage_min"
      ],
      "properties": {
        "known_unsafe_false_accepts_max": {"const": 0},
        "safe_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "coarse_reason_accuracy_min": {"type": "number", "minimum": 0, "maximum": 1},
        "analyzer_coverage_min": {"type": "number", "minimum": 0, "maximum": 1},
        "oracle_benefit_coverage_min": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "task_type",
        "split",
        "framework",
        "domain",
        "repository",
        "source_binding",
        "context",
        "candidate",
        "verification_plan"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"},
        "task_type": {"enum": ["contract_inference", "rewrite_validation", "optimizer_workload"]},
        "split": {"const": "final_blind"},
        "framework": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "release", "commit_sha"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "release": {"type": "string", "minLength": 1},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "public_symbol", "binding_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "public_symbol": {"type": "string", "minLength": 1},
            "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration", "phase", "named_modes", "assumptions"],
          "properties": {
            "configuration": {"type": "object"},
            "phase": {"enum": ["construction", "iteration", "training", "evaluation", "serving"]},
            "named_modes": {"type": "array", "items": {"type": "string"}},
            "assumptions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operators"],
          "properties": {
            "kind": {"enum": ["none", "cache_prefix", "registered_parameter_replay", "adjacent_swap"]},
            "operators": {"type": "array", "items": {"type": "string"}},
            "cost_profile_id": {"type": "string"}
          }
        },
        "verification_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_checks", "effect_checks", "performance_checks"],
          "properties": {
            "output_checks": {"type": "array", "items": {"type": "string"}},
            "effect_checks": {"type": "array", "items": {"type": "string"}},
            "performance_checks": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
