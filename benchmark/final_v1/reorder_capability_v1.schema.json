{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocontract.local/schema/reorder_capability_v1.schema.json",
  "title": "AutoContract locally replayable ReorderCapabilityV1 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_context_sha256",
    "input_schema_sha256",
    "left",
    "right",
    "relation",
    "status",
    "assurance_level",
    "verifier",
    "proof_artifact",
    "proof_sha256",
    "proof_scope"
  ],
  "properties": {
    "schema_version": {"const": "autocontract.reorder-capability.v1"},
    "operation_context_sha256": {"$ref": "#/$defs/sha256"},
    "input_schema_sha256": {"$ref": "#/$defs/sha256"},
    "left": {"$ref": "#/$defs/operator_binding"},
    "right": {"$ref": "#/$defs/operator_binding"},
    "relation": {"const": "commutes"},
    "status": {"const": "supported"},
    "assurance_level": {"const": "locally_replayed_restricted_static"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "version", "source_sha256"],
      "properties": {
        "verifier_id": {"const": "autocontract.restricted-affine-commutativity"},
        "version": {"const": "1.0.0"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proof_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain", "left_ir", "right_ir", "left_then_right_ir", "right_then_left_ir", "equality"],
      "properties": {
        "kind": {"const": "restricted_affine_commutativity_v0"},
        "domain": {"const": "python_int_unbounded_no_exception"},
        "left_ir": {"$ref": "#/$defs/affine_ir"},
        "right_ir": {"$ref": "#/$defs/affine_ir"},
        "left_then_right_ir": {"$ref": "#/$defs/affine_ir"},
        "right_then_left_ir": {"$ref": "#/$defs/affine_ir"},
        "equality": {"const": true}
      }
    },
    "proof_sha256": {"$ref": "#/$defs/sha256"},
    "proof_scope": {"const": "Exact source-bound unary affine functions over Python unbounded integers; no exceptions, state, I/O, or hidden dispatch."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "contract_sha256", "source_index_sha256"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "affine_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficient", "intercept"],
      "properties": {
        "coefficient": {"$ref": "#/$defs/fraction"},
        "intercept": {"$ref": "#/$defs/fraction"}
      }
    }
  }
}
