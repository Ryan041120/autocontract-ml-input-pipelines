{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/autocontract/optimizer-constraint-bundle-v0.schema.json",
  "title": "AutoContract backend-shaped optimizer constraint bundle v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "operation_context_sha256", "contract_bundle_sha256", "input_schema_sha256", "operators", "backends", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "autocontract.optimizer-constraint-bundle.v0"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "operation_context_sha256": {"$ref": "#/$defs/sha256"},
    "contract_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "input_schema_sha256": {"$ref": "#/$defs/sha256"},
    "operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operator"}},
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cedar", "hycache", "cachew"],
      "properties": {
        "cedar": {"type": "object"},
        "hycache": {"type": "object"},
        "cachew": {"type": "object"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "strict_cache_eligible", "barrier", "barrier_reasons", "parameter_key_required", "contract_sha256", "source_index_sha256"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "strict_cache_eligible": {"type": "boolean"},
        "barrier": {"type": "boolean"},
        "barrier_reasons": {"type": "array", "items": {"type": "string"}},
        "parameter_key_required": {"type": "boolean"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_index_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
