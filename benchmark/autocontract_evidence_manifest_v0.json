  "purpose": "Audit the historical analyzer evidence without pooling results produced by different Effect versions.",
  "aggregation_policy": {
    "cross_version_primary_accuracy": "forbidden",
    "reason": "H6-H7H are sequential model-development stages with different analyzers, adapters, contexts, and decision granularities.",
    "final_claim_requirement": "A separately preregistered benchmark evaluated once with one frozen analyzer and one fixed metric schema."
  },
  "entries": [
